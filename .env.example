# Contraseña única para entrar al sitio (tabla, datos liberados y /admin)
ADMIN_PASSWORD=tu_clave_segura
# Correo opcional para el acceso maestro. Si se omite, usa admin@local
ADMIN_EMAIL=admin@local

# Correos de invitación (Resend)
RESEND_API_KEY=
EMAIL_FROM=ENTREGABLE AB MAURI <accesos@tudominio.com>
# URL pública del sitio para el botón del correo. En Vercel se infiere si se omite.
APP_URL=https://tu-dominio.com

# Vercel Blob (Storage en el dashboard de Vercel → Storage → Blob → Connect)
# Opcional: solo para Excel > ~4 MB o persistencia estable en Vercel. Sin esto la app usa subida directa.
# BLOB_READ_WRITE_TOKEN=
